# App
APP_ENV=production
API_PORT=3000

# Postgres
DATABASE_URL=postgres://dev:admin123@localhost:5432/fastify
DATABASE_PORT=5432
DATABASE_DB=fastify
DATABASE_USERNAME=dev
DATABASE_PASSWORD=admin123

# Cache (Valkey)
CACHE_DISABLED=false
CACHE_HOST=0.0.0.0
CACHE_PORT=6379
CACHE_PASSWORD=admin123

# RabbitMQ
RABBIT_DISABLED=false
RABBIT_HOST=0.0.0.0
RABBIT_PORT=5672
RABBIT_TRANSPORT=amqp
RABBIT_USER=guest
RABBIT_PASSWORD=guest
WORKER_QUEUE=task_queue
WORKER_EXCHANGE=main
WORKER_BINDING_KEY="task.#"
WORKER_PREFETCH=1

# Logs
REQUEST_LOG_LEVEL=info
APP_LOG_LEVEL=info

# Optional OpenTelemetry collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
