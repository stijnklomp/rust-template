# App
APP_ENV=tests
API_PORT=3000

# Postgres
DATABASE_URL=postgres://user:pass@localhost:5432/db
DATABASE_PORT=5432
DATABASE_DB=db
DATABASE_USERNAME=user
DATABASE_PASSWORD=pass

# Cache (Valkey)
CACHE_DISABLED=true
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=admin123

# RabbitMQ
RABBIT_DISABLED=true
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_TRANSPORT=amqp
RABBIT_USER=guest
RABBIT_PASSWORD=guest
WORKER_QUEUE=task_queue
WORKER_EXCHANGE=main
WORKER_BINDING_KEY="task.#"
WORKER_PREFETCH=1

# Logs
REQUEST_LOG_LEVEL=info
APP_LOG_LEVEL=info
